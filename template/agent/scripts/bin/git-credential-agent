#!/usr/bin/env bash
# Git credential helper for the agent account.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/agent/scripts/agent-project-env.sh"

CRED_FILE="${AGENT_GITHUB_CREDENTIALS}"

case "${1:-}" in
  get|fill)
    python3 - "$CRED_FILE" <<'PY'
import json, sys

with open(sys.argv[1], encoding="utf-8") as fh:
    creds = json.load(fh)

print(f"username={creds['username']}")
print(f"password={creds['access_token']}")
PY
    ;;
  store|erase)
    ;;
  *)
    echo "git-credential-agent: unknown operation: ${1:-}" >&2
    exit 1
    ;;
esac
